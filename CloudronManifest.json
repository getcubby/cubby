{
  "id": "io.cloudron.cubby",
  "title": "Cubby",
  "author": "Cloudron Team",
  "tagline": "All the file sharing you need, none of the bloat",
  "version": "2.18.0",
  "upstreamVersion": "2.18.0",
  "minBoxVersion": "10.0.5",
  "healthCheckPath": "/api/healthcheck",
  "icon": "file://logo.png",
  "description": "file://DESCRIPTION.md",
  "forumUrl": "https://forum.cloudron.io/category/132/cubby",
  "documentationUrl": "https://docs.cloudron.io/packages/cubby/",
  "website": "https://getcubby.org",
  "contactEmail": "support@cloudron.io",
  "tags": [
    "file",
    "sharing",
    "documents",
    "drive",
    "onedrive",
    "dropbox",
    "pcloud",
    "nextcloud"
  ],
  "changelog": "file://CHANGELOG.md",
  "httpPort": 3000,
  "memoryLimit": 536870912,
  "addons": {
    "localstorage": {
      "sqlite": {
        "paths": [
          "/app/data/cubby.db"
        ]
      }
    },
    "postgresql": {},
    "sendmail": {
      "supportsDisplayName": true
    },
    "oidc": {
      "loginRedirectUri": "/auth/callback,/api/v1/mobile/callback,io.cloudron.cubby://auth/callback"
    },
    "scim": {}
  },
  "mediaLinks": [
    "https://screenshots.cloudron.io/io.cloudron.cubby/cubby_02.png"
  ],
  "manifestVersion": 2
}
