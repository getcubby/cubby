#!/bin/bash

set -eu

readonly source_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly DATA_DIR="/tmp/cubby_test"
readonly DEFAULT_TESTS="./backend/test/*-test.js ./backend/routes/test/*-test.js"

prepare_data_dir() {
    rm -rf "${DATA_DIR}"
    mkdir -p "${DATA_DIR}"/{data,groups,thumbnails,sessions,.recoll}
}

export_test_env() {
    export CUBBY_ENV=test

    export PORT="3456"
    export APP_ORIGIN="http://127.0.0.1:${PORT}"
}

# fast path: if explicit tests are provided, run them directly and skip setup.
if [[ $# -gt 0 ]]; then
    export_test_env
    prepare_data_dir
    cd "${source_dir}"
    CUBBY_ENV=test ./node_modules/.bin/mocha --bail --no-timeouts --exit -R spec "$@"
    exit $?
fi

cd "${source_dir}"
export_test_env

echo "=> Prepare test data directory at ${DATA_DIR}"
prepare_data_dir

TESTS=${DEFAULT_TESTS}

echo "=> Run tests with mocha"
CUBBY_ENV=test ./node_modules/.bin/mocha --bail --no-timeouts --exit -R spec ${TESTS}
